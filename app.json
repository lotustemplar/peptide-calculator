{
  "expo": {
    "name": "Fitgen Peptide Calculator",
    "slug": "peptide-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "package": "com.peptidecalculator.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B6B4A"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "dose-reminders"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "5c98baa4-ac40-4204-a2fb-f695c287caed"
      }
    }
  }
}
